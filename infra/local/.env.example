# Copy to infra/local/.env (ignored). Pass --env-file infra/local/.env explicitly.
# Never commit real keys. Local storage needs none of these variables.
MEDIA_S3_NAMESPACE=r2-primary
MEDIA_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=property-platform-originals
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Optional API-only read credentials. The ingestion runner retains the write token.
MEDIA_S3_READ_ACCESS_KEY_ID=
MEDIA_S3_READ_SECRET_ACCESS_KEY=
# Optional, separate bucket with a custom domain; private originals stay private.
MEDIA_S3_PUBLIC_BUCKET=property-platform-public-media
MEDIA_PUBLIC_BASE_URL=https://media.example.com
MEDIA_PUBLICATION_ENABLED=0
