{
  "name": "liwa-atlas",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @liwa/web dev",
    "build": "pnpm --filter @liwa/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:web": "pnpm --filter @liwa/web test",
    "docs:check": "node scripts/check-doc-links.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "contracts:generate": "pnpm --filter @liwa/contracts generate",
    "contracts:check": "pnpm --filter @liwa/contracts check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
