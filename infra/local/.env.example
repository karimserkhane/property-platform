# Copy to infra/local/.env (ignored). Pass --env-file infra/local/.env explicitly.
# Never commit real keys. Local storage needs none of these variables.
# Cloudflare dashboard: Storage & databases > R2 > Overview > API Tokens > Manage.
# Use S3 Access Key ID / Secret Access Key, not a general Cloudflare Bearer token.
# Start with a Standard private bucket; leave r2.dev and custom domains disabled.
MEDIA_S3_NAMESPACE=r2-primary
MEDIA_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=property-platform-originals
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Optional API-only read credentials. The ingestion runner retains the write token.
MEDIA_S3_READ_ACCESS_KEY_ID=
MEDIA_S3_READ_SECRET_ACCESS_KEY=
# Optional, separate bucket with a custom domain; private originals stay private.
MEDIA_S3_PUBLIC_BUCKET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_PUBLICATION_ENABLED=0

# A30 (docs/engineering/BACKUPS.md): optional second copy of each nightly backup.
# Empty = no copy. "directory" = the host folder below (external disk, synced folder,
# network share). "s3" = any S3-compatible private bucket: needs the owner's approval
# (cost, provider) before use; leave its keys empty until then. S3 refuses to run without
# BACKUP_COPY_AGE_RECIPIENT, the age PUBLIC key (age1...): each file is encrypted here first.
# The private key never goes in this file, in Git, in an image or in a chat.
PROPERTY_PLATFORM_BACKUP_COPY_TARGET=
PROPERTY_PLATFORM_BACKUP_COPY_DIR=
BACKUP_COPY_S3_ENDPOINT_URL=
BACKUP_COPY_S3_REGION=auto
BACKUP_COPY_S3_BUCKET=
BACKUP_COPY_S3_PREFIX=property-platform-backups
BACKUP_COPY_S3_ACCESS_KEY_ID=
BACKUP_COPY_S3_SECRET_ACCESS_KEY=
BACKUP_COPY_AGE_RECIPIENT=
