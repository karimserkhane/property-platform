# Server-only. Do not use NEXT_PUBLIC_ for the upstream or a credential.
PROPERTY_PLATFORM_API_ORIGIN=http://127.0.0.1:8000
# Opt-in for a LOCAL compiled preview only. Django non-debug still refuses it.
# PROPERTY_PLATFORM_ENABLE_LOCAL_PREVIEW=1
# Project neighbourhood maps: local (default) or google. No paid Maps JavaScript API.
PROJECT_NEIGHBOURHOOD_PROVIDER=local
# Optional PUBLIC browser key, restricted to Maps Embed API + your HTTP referrers.
# This specific key is included in Google's iframe URL. Never use a server key.
# GOOGLE_MAPS_EMBED_BROWSER_KEY=
